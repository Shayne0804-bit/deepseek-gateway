# ============================================================
#  DeepSeek Gateway - configuration
#  Copiez ce fichier en ".env" puis remplissez les valeurs.
#  Les variables d'environnement reelles ont priorite sur .env.
# ============================================================

# --- Cle API DeepSeek ORIGINALE (ne la partagez jamais) -----
DEEPSEEK_API_KEY=sk-votre-cle-originale-ici

# --- Reseau -------------------------------------------------
# 127.0.0.1 = accessible uniquement depuis cette machine.
# 0.0.0.0   = accessible depuis le reseau (necessaire pour un VPS).
HOST=127.0.0.1
PORT=8787

# URL publique que votre ami utilisera (ex: https://api.mondomaine.fr).
# Facultatif : sert uniquement a afficher les exemples du guide.
PUBLIC_BASE_URL=

# --- Administration ----------------------------------------
# Mot de passe du panneau, utilise UNIQUEMENT au premier demarrage.
# Si absent, un mot de passe aleatoire est genere et ecrit dans
# data/admin-password.txt (a changer dans le panneau).
ADMIN_PASSWORD=

# Duree de vie d'une session admin, en heures (defaut : 12).
SESSION_HOURS=12

# Mettre 1 si la passerelle est derriere un reverse proxy HTTPS
# (Caddy / Nginx / Cloudflare Tunnel) pour que le cookie soit Secure.
TRUST_PROXY=0

# --- HTTPS (optionnel, requis par Claude Desktop) -----------------------
# HTTP reste disponible sur PORT ; HTTPS s'active si un certificat est fourni.
# Generez un certificat local + CA de confiance : pwsh -File tools/generate-local-tls.ps1
HTTPS_PORT=8788
TLS_CERT_FILE=
TLS_KEY_FILE=
# Alternative : certificat PFX Windows (au lieu de TLS_CERT_FILE/TLS_KEY_FILE)
TLS_PFX_FILE=
TLS_PFX_PASSPHRASE=

# --- Divers -------------------------------------------------
# Vide = dossier ./data (recommande).
DATA_DIR=
# Taille maximale d'une requete entrante, en octets (defaut : 32 Mo).
# Claude Code (contexte long, images, fenetres 1M tokens) peut envoyer de gros
# corps : 0 = illimite (attention a la memoire du serveur).
MAX_BODY_BYTES=33554432
UPSTREAM_TIMEOUT_MS=1800000
LOG_LEVEL=info
