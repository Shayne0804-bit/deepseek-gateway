# ============================================================
#  VALARIA Gateway API - configuration
#  Copiez ce fichier en ".env" puis remplissez les valeurs.
#  Les variables d'environnement reelles ont priorite sur .env.
# ============================================================

# --- Cle API DeepSeek ORIGINALE (ne la partagez jamais) -----
DEEPSEEK_API_KEY=sk-votre-cle-originale-ici

# Modele REELLEMENT appele chez DeepSeek, quel que soit le nom demande.
# Defaut : deepseek-flash (v4-pro n'est pas utilise, meme s'il reste expose).
# Mettre none pour desactiver ce forcage.
BILLED_MODEL=deepseek-flash

# --- Reseau -------------------------------------------------
# 127.0.0.1 = accessible uniquement depuis cette machine.
# 0.0.0.0   = accessible depuis le reseau (necessaire pour un VPS).
HOST=127.0.0.1
PORT=8787

# URL publique que votre ami utilisera (ex: https://api.mondomaine.fr).
# Facultatif : sert uniquement a afficher les exemples du guide.
PUBLIC_BASE_URL=

# --- Administration ----------------------------------------
# Mot de passe du panneau, utilise UNIQUEMENT au premier demarrage.
# Si absent, un mot de passe aleatoire est genere et ecrit dans
# data/admin-password.txt (a changer dans le panneau).
ADMIN_PASSWORD=

# Duree de vie d'une session admin, en heures (defaut : 12).
SESSION_HOURS=12

# Mettre 1 si la passerelle est derriere un reverse proxy HTTPS
# (Caddy / Nginx / Cloudflare Tunnel) pour que le cookie soit Secure.
TRUST_PROXY=0

# --- HTTPS (optionnel, requis par Claude Desktop) -----------------------
# HTTP reste disponible sur PORT ; HTTPS s'active si un certificat est fourni.
# Generez un certificat local + CA de confiance : pwsh -File tools/generate-local-tls.ps1
HTTPS_PORT=8788
TLS_CERT_FILE=
TLS_KEY_FILE=
# Alternative : certificat PFX Windows (au lieu de TLS_CERT_FILE/TLS_KEY_FILE)
TLS_PFX_FILE=
TLS_PFX_PASSPHRASE=

# --- Production / garde-fous -------------------------------------------
# Limite de requetes par IP et par minute sur /admin/api et /v1 (0 = desactive).
IP_RATE_LIMIT_PER_MIN=240
# Nombre maximal de requetes API simultanees, toutes cles confondues (0 = illimite).
MAX_CONCURRENT_REQUESTS=200
# Format des logs : text (defaut) ou json (recommande en production).
LOG_FORMAT=text
# Retention des journaux d'usage en jours (0 = conservation illimitee).
USAGE_RETENTION_DAYS=0
# Cle maitre de chiffrement des secrets (32 octets en base64).
# Si vide : generee au premier demarrage dans data/master.key (droits 0600).
# A fixer explicitement si data/ n'est pas persistant (volume ephemere).
MASTER_KEY=

# --- Connexion portail par email (code OTP) ----------------------------
# Transport : console (dev, code dans les logs), resend (API HTTPS), smtp (TLS implicite 465).
# Sans configuration, la connexion par clé API reste le seul mode.
MAIL_TRANSPORT=
MAIL_FROM=
MAIL_FROM_NAME=VALARIA Gateway API
# Resend (recommande avec domaine verifie : SPF/DKIM/DMARC) :
RESEND_API_KEY=
# SMTP TLS implicite, ex. Gmail mot de passe d'application :
# SMTP_URL=smtps://adresse%40gmail.com:motdepasseapplication@smtp.gmail.com:465
SMTP_URL=
# Duree de validite du code en minutes (5 a 30).
OTP_EXPIRES_MINUTES=10
# Delai minimum entre deux envois de code pour un meme email (secondes).
OTP_COOLDOWN_SECONDS=30
# Nombre maximal d'envois par email sur 15 minutes (0 = illimite).
OTP_MAX_PER_EMAIL=0
# Nombre maximal de demandes par IP sur 15 minutes.
OTP_MAX_PER_IP=10

# --- Inscription autonome (compte cree par l'utilisateur) --------------
# 1 = les visiteurs peuvent creer un compte avec leur email puis leur cle API.
# Necessite un transport email configure ci-dessus. 0 = inscriptions fermees.
SIGNUP_ENABLED=1
# Pass d'essai accorde a chaque nouvel inscrit.
TRIAL_DAYS=7
# Credit site du pass gratuit (1.125 = equivalent de l'ancien 0.30 $ reel).
TRIAL_CREDIT_SITE_USD=1.125
# Ancienne variable TRIAL_QUOTA_USD (cout reel) : convertie automatiquement x SITE_CREDIT_RATE.
# Le pass d'essai n'a plus de quota de requetes.
TRIAL_RPM_LIMIT=20
TRIAL_CONCURRENCY_LIMIT=2
TRIAL_MAX_OUTPUT_TOKENS=4096

# --- Devises / prix des pass --------------------------------------------
# Source des taux de change (base EUR), mise en cache 12 h cote serveur.
# Detecte le pays via Cloudflare (CF-IPCountry), sinon timezone/locale.
# EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/EUR

# --- Securite inscription (anti multi-comptes / temp mail / VPN) --------
# Derriere Cloudflare (proxy orange), mettre 1 pour utiliser la vraie IP client.
TRUST_CLOUDFLARE=0
# Un seul compte par IP et par appareil sur la fenetre indiquee.
SIGNUP_MAX_PER_IP=1
SIGNUP_IP_WINDOW_DAYS=30
SIGNUP_MAX_PER_DEVICE=1
SIGNUP_DEVICE_WINDOW_DAYS=30
# Blocage des domaines jetables connus (liste locale).
BLOCK_TEMP_MAIL=1
# Domaines supplementaires a bloquer, separes par des virgules.
BLOCKED_EMAIL_DOMAINS=

# Captcha : turnstile (passif, peut valider sans clic) ou hcaptcha (case visible).
CAPTCHA_PROVIDER=turnstile
CAPTCHA_REQUIRED=1
# hCaptcha (case « Je suis humain ») : creer un site sur hcaptcha.com.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# Cloudflare Turnstile (gratuit, passif) : creer un widget sur dash.cloudflare.com.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=1
TURNSTILE_TIMEOUT_MS=5000

# IPQualityScore (VPN/proxy/Tor, validation email) : IPQS_API_KEY requis.
IPQS_API_KEY=
IPQS_MIN_FRAUD_SCORE=85
IPQS_BLOCK_VPN=1
IPQS_BLOCK_HOSTING=1
# Controle IP actif si une cle IPQS est fournie.
FRAUD_CHECK_ENABLED=1
# Validation email via IPQS (selon le plan souscrit).
EMAIL_VALIDATION_ENABLED=0
# En cas de panne du service de verification, refuser l'inscription.
FRAUD_FAIL_CLOSED=1

# --- Base de donnees -----------------------------------------
# sqlite (defaut, fichier /data/gateway.db) ou mongo.
DB_DRIVER=sqlite
# Requis si DB_DRIVER=mongo. Ne jamais mettre cette URI dans Git.
MONGODB_URI=
MONGODB_DB=valaria_gateway
# Importe automatiquement SQLite -> MongoDB au demarrage si MongoDB est vide.
MONGODB_MIGRATE_SQLITE=1
# Fichier source de migration (defaut : $DATA_DIR/gateway.db).
MONGODB_SQLITE_FILE=
# 1 = le demarrage echoue si la migration demandee echoue.
MONGODB_MIGRATION_REQUIRED=0

# --- Divers -------------------------------------------------
# Vide = dossier ./data (recommande).
DATA_DIR=
# Taille maximale d'une requete entrante, en octets (defaut : 32 Mo).
# Claude Code (contexte long, images, fenetres 1M tokens) peut envoyer de gros
# corps : 0 = illimite (attention a la memoire du serveur).
MAX_BODY_BYTES=33554432
UPSTREAM_TIMEOUT_MS=1800000
# debug | info | warn | error | silent (aucune sortie normale).
LOG_LEVEL=info


# Credit site : le client est debite du cout reel x SITE_CREDIT_RATE (3.75 par defaut).
SITE_CREDIT_RATE=3.75
# Plafond glissant de credit site (heures) applique selon le pass.
SITE_CREDIT_WINDOW_HOURS=5


# Optionnel : secret TOTP base32 pour la 2FA admin.
ADMIN_TOTP_SECRET=

# Les alias de gros modeles sont servis par flash mais factures au tarif premium.
ALIAS_PREMIUM_BILLING=1

# --- Discord (optionnel) -----------------------------------
# Active le bot Discord au démarrage du serveur.
DISCORD_ENABLED=1
# Token du bot (Discord Developer Portal -> Bot -> Reset Token).
DISCORD_TOKEN=
# ID du serveur Discord où créer la catégorie et les salons.
DISCORD_GUILD_ID=
# Nom de la catégorie créée automatiquement.
DISCORD_CATEGORY_NAME=｜💠｜𝐕𝐀𝐋𝐀𝐑𝐈𝐀 𝐆𝐀𝐓𝐄𝐖𝐀𝐘
# 1 = crée les salons manquants ; 0 = commandes seulement.
DISCORD_SYNC_CHANNELS=1
# URL publique utilisée dans les embeds (défaut : PUBLIC_BASE_URL).
DISCORD_SITE_URL=

# SasPay (paiement des pass). Cle serveur uniquement + secret webhook.
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_BASE_URL=https://api.saspay.me/api/v1

# PAYG : nombre de FCFA payes pour 1 $ de credit site (defaut 550).
PAYG_FCFA_PER_CREDIT=550

# Reservation : part du prompt supposee servie par le cache (Claude Desktop).
RESERVATION_CACHE_HIT_RATE=0.98

