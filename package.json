    "src/",
    "public/",
    "server.js",
    ".env.example",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test",
    "prepublishOnly": "node --test test"
  },
  "keywords": [
    "deepseek",
    "gateway",
    "api",
    "quota",
    "proxy",
    "openai",
    "anthropic",
    "claude",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "Shayne0804-bit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shayne0804-bit/deepseek-gateway.git"
  },
  "homepage": "https://github.com/Shayne0804-bit/deepseek-gateway#readme",
  "bugs": {
    "url": "https://github.com/Shayne0804-bit/deepseek-gateway/issues"
  },
