{
  "name": "valaria-gateway",
  "version": "3.6.4",
  "description": "Client et serveur VALARIA Gateway API : console cliente connectée à une instance hébergée (quotas, chat, logs) et passerelle auto-hébergeable.",
  "type": "module",
  "bin": {
    "valaria-gateway": "bin/valaria-gateway.js"
  },
  "valaria": {
    "defaultUrl": ""
